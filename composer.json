{
    "name": "spiggle/filawarden-core",
    "description": "Laravel Operations Intelligence Platform for Filament - Core Edition",
    "type": "library",
    "license": "MIT",
    "homepage": "https://skillbobby.github.io/spiggle/Spiggle-FilaWarden-Core/",
    "support": {
        "issues": "https://github.com/skillbobby/Spiggle-FilaWarden-Core/issues",
        "source": "https://github.com/skillbobby/Spiggle-FilaWarden-Core"
    },
    "keywords": [
        "spiggle",
        "laravel",
        "filament",
        "filament-plugin",
        "filament-v4",
        "filament-v5",
        "filawarden",
        "monitoring",
        "security",
        "health"
    ],
    "authors": [
        {
            "name": "Spiggle",
            "email": "skillbobby@outlook.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-pdo": "*",
        "filament/filament": "^4.0 || ^5.0",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "spatie/laravel-package-tools": "^1.16 || ^1.90",
        "dragonmantank/cron-expression": "^3.0",
        "symfony/finder": "^7.0 || ^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Spiggle\\FilaWarden\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spiggle\\FilaWarden\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Spiggle\\FilaWarden\\FilaWardenServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
