{
    "name": "spiggle/filawarden-core",
    "description": "Laravel Operations Intelligence Platform for Filament - Core Edition",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Spiggle Software",
            "email": "support@spiggle.dev"
        }
    ],
    "version": "1.0.0",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-pdo": "*",
        "filament/filament": "^5.0",
        "illuminate/support": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16|^1.90",
        "dragonmantank/cron-expression": "^3.0",
        "symfony/finder": "^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0|^12.0",
        "orchestra/testbench": "^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "Spiggle\\FilaWarden\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spiggle\\FilaWarden\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Spiggle\\FilaWarden\\FilaWardenServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
